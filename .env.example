# Copy to .env and fill in. Never commit .env.

# Local Gemma through Ollama (primary). Run `ollama list` to see the exact model name.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# Backup: Gemma through the Gemini API (used ONLY if Ollama is off, slow or gives bad JSON)
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it

# ElevenLabs vocal clips
ELEVENLABS_API_KEY=
# Credit safety: caps per app session, and free test mode (beeps instead of real clips)
ELEVENLABS_MAX_CHARS=600
ELEVENLABS_MAX_SFX=3
ELEVENLABS_MOCK=1
